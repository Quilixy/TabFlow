{
  "manifest_version": 3,
  "name": "TabFlow",
  "version": "0.4.2",
  "description": "Sekmelerini klasörlere ve serbest bir tuvale kaydet, kapat ve saniyeler içinde geri yükle.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TabFlow",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/app/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "commands": {
    "open-app": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "TabFlow'u tam ekranda aç"
    }
  },
  "permissions": ["tabs", "storage", "unlimitedStorage", "favicon"]
}
