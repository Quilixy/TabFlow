{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.4.2",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/app/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "commands": {
    "open-app": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmdOpenApp__"
    },
    "save-to-last-folder": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSaveToLast__"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "favicon",
    "contextMenus",
    "tabGroups",
    "downloads"
  ]
}
